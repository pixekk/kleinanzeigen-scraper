# Copy to .env and fill in with your mail server's real values.
# .env is not committed (.gitignore) - the real credentials live here.

SMTP_HOST=mail.your-domain.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=scanner@your-domain.com
SMTP_PASSWORD=your-mailbox-password
SMTP_FROM=scanner@your-domain.com

MAIL_TO=your.address@example.com

TZ=Europe/Berlin
LOG_LEVEL=INFO
