# Kopieren nach .env und mit den echten Werten deines Mailservers fuellen.
# .env wird nicht committet (.gitignore) - hier landen die echten Zugangsdaten.

SMTP_HOST=mail.deine-domain.de
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=scanner@deine-domain.de
SMTP_PASSWORD=postfach-passwort-hier
SMTP_FROM=scanner@deine-domain.de

MAIL_TO=deine.adresse@example.com

TZ=Europe/Berlin
LOG_LEVEL=INFO
